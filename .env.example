# Copia este archivo como .env y reemplaza los valores.
# Nunca subas .env al repositorio (está en .gitignore).

# Base de datos MySQL
DB_HOST=localhost
DB_DATABASE=nombre_de_la_base_de_datos
DB_USER=usuario_mysql
DB_PASSWORD=contraseña_segura_aqui
DB_PORT=3306

# Semilla de datos (seed)
SEED_ADMIN_EMAIL=admin@example.com
SEED_ADMIN_PASSWORD=coloca_una_password_segura
SEED_ADMIN_NAME=Administrador

SEED_USER_EMAIL=user@example.com
SEED_USER_PASSWORD=coloca_una_password_segura
SEED_USER_NAME=Usuario de prueba

BCRYPT_SALT_ROUNDS=12

# Servidor
SERVER_PORT=3000
NODE_ENV=development

# JWT — secreto aleatorio de al menos 32 caracteres
JWT_SECRET=cambia_esto_por_al_menos_32_caracteres_aleatorios
JWT_ISSUER=ServidorFeiJWT
JWT_AUDIENCE=ClientesFeiJWT
JWT_EXPIRES_IN=20m

# Almacenamiento de archivos
# true  = archivos guardados en la base de datos (BLOB)
# false = archivos guardados en disco (carpeta uploads/)
# IMPORTANTE: la variable se llama FILES_IN_DB (no FILES_IN_BD)
FILES_IN_DB=false

# CORS — orígenes permitidos separados por coma
CORS_ALLOWED_ORIGINS=http://localhost:8080,http://localhost:8081

# Swagger UI (usa false o elimina en producción)
ENABLE_SWAGGER=true

# Rate limiting — registro público de cuenta
# Valores por defecto de producción: 900000 ms (15 min) / 10 intentos por IP.
# Para pruebas manuales locales sube el límite de intentos o reduce la ventana.
# Ejemplo desarrollo: REGISTRO_RATE_LIMIT_WINDOW_MS=60000 / REGISTRO_RATE_LIMIT_MAX_REQUESTS=100
REGISTRO_RATE_LIMIT_WINDOW_MS=900000
REGISTRO_RATE_LIMIT_MAX_REQUESTS=10
