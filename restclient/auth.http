@baseUrl = http://localhost:3000
@adminEmail = gvera@uv.mx
@adminPassword = patito
@userEmail = patito@uv.mx
@userPassword = patito

### Login como Administrador
# @name loginAdmin
POST {{baseUrl}}/api/auth
Content-Type: application/json
Accept: application/json

{
    "email": "{{adminEmail}}",
    "password": "{{adminPassword}}"
}

### Login como Usuario
# @name loginUser
POST {{baseUrl}}/api/auth
Content-Type: application/json
Accept: application/json

{
    "email": "{{userEmail}}",
    "password": "{{userPassword}}"
}

### Obtener categorías con token de Administrador
GET {{baseUrl}}/api/categorias
Accept: application/json
Authorization: Bearer {{loginAdmin.response.body.$.jwt}}

### Obtener tiempo restante del token de Administrador
GET {{baseUrl}}/api/auth/tiempo
Accept: text/plain
Authorization: Bearer {{loginAdmin.response.body.$.jwt}}

### Obtener roles con token de Administrador
GET {{baseUrl}}/api/roles
Accept: application/json
Authorization: Bearer {{loginAdmin.response.body.$.jwt}}

### Prueba de seguridad: intentar obtener categorías sin token
GET {{baseUrl}}/api/categorias
Accept: application/json

### Prueba de seguridad: login con contraseña incorrecta
POST {{baseUrl}}/api/auth
Content-Type: application/json
Accept: application/json

{
    "email": "{{adminEmail}}",
    "password": "password_incorrecto"
}

### Prueba de seguridad: login con formato inválido
POST {{baseUrl}}/api/auth
Content-Type: application/json
Accept: application/json

{
    "email": "correo-invalido",
    "password": ""
}