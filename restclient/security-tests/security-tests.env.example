# Copia este archivo como security-tests.env y rellena con tus valores locales.
# NUNCA subas security-tests.env a GitHub.
#
# Estos valores NO son credenciales reales.
# Deben coincidir con los usuarios que existan en tu base de datos de desarrollo.
#
# Uso: reemplaza las variables @variable en cada archivo .http por estos valores,
# o configura rest-client.environmentVariables en .vscode/settings.json.

BASE_URL=http://localhost:3000
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=Admin123
USER_EMAIL=user@example.com
USER_PASSWORD=Usuario123
