### ============================================================
### 08-pedidos.http — Módulo de pedidos
### ============================================================
### Cubre:
###   - Crear pedido como usuario
###   - Listar mis pedidos
###   - Ver detalle propio
###   - Intentar ver pedido ajeno (IDOR)
###   - Listar todos como admin
###   - Cambiar estado como admin
###   - Intentar cambiar estado como usuario (403)
###   - Crear pedido con precio manipulado (debe ser ignorado)
###   - Crear pedido con cantidad inválida (400)
###   - Crear pedido con producto inexistente (404)
###   - Crear pedido con carrito vacío (400)
### ============================================================

@baseUrl       = http://localhost:3000
@adminEmail    = Admin@example.com
@adminPassword = AdminTest2026!
@userEmail     = claudiojtz1402@gmail.com
@userPassword  = l9523L990@
@user2Email    = user@example.com
@user2Password = UserTest2026!

###
# @name loginAdmin
# Esperado: 200 OK
POST {{baseUrl}}/api/auth
Content-Type: application/json
Accept: application/json

{
  "email": "{{adminEmail}}",
  "password": "{{adminPassword}}"
}

###
# @name loginUser
# Esperado: 200 OK
POST {{baseUrl}}/api/auth
Content-Type: application/json
Accept: application/json

{
  "email": "{{userEmail}}",
  "password": "{{userPassword}}"
}

###
# @name loginUser2
# Esperado: 200 OK — segundo usuario para prueba IDOR
POST {{baseUrl}}/api/auth
Content-Type: application/json
Accept: application/json

{
  "email": "{{user2Email}}",
  "password": "{{user2Password}}"
}

### ── CREAR PEDIDO ─────────────────────────────────────────────

###
# @name crearPedido
# Esperado: 201 Created — pedido creado con precios del servidor
# El campo "precio" enviado en el body debe ser completamente ignorado por el backend
POST {{baseUrl}}/api/pedidos
Content-Type: application/json
Accept: application/json
Authorization: Bearer {{loginUser.response.body.$.jwt}}

{
  "items": [
    { "productoId": 1, "cantidad": 2 },
    { "productoId": 2, "cantidad": 1 }
  ]
}

###
# Verificar que el backend rechaza campos extra:
# precio, subtotal y total no están permitidos porque el total se calcula en servidor.
# Esperado: 400 Bad Request — datos de entrada inválidos
POST {{baseUrl}}/api/pedidos
Content-Type: application/json
Accept: application/json
Authorization: Bearer {{loginUser.response.body.$.jwt}}

{
  "items": [
    { "productoId": 1, "cantidad": 1 }
  ],
  "total": 0.01,
  "subtotal": 0.01,
  "precio": 0.01
}

###
# Esperado: 400 Bad Request — carrito vacío
POST {{baseUrl}}/api/pedidos
Content-Type: application/json
Accept: application/json
Authorization: Bearer {{loginUser.response.body.$.jwt}}

{
  "items": []
}

###
# Esperado: 400 Bad Request — cantidad = 0 (fuera de rango 1-99)
POST {{baseUrl}}/api/pedidos
Content-Type: application/json
Accept: application/json
Authorization: Bearer {{loginUser.response.body.$.jwt}}

{
  "items": [
    { "productoId": 1, "cantidad": 0 }
  ]
}

###
# Esperado: 400 Bad Request — cantidad = 100 (fuera de rango 1-99)
POST {{baseUrl}}/api/pedidos
Content-Type: application/json
Accept: application/json
Authorization: Bearer {{loginUser.response.body.$.jwt}}

{
  "items": [
    { "productoId": 1, "cantidad": 100 }
  ]
}

###
# Esperado: 404 Not Found — producto con id 999999 no existe
POST {{baseUrl}}/api/pedidos
Content-Type: application/json
Accept: application/json
Authorization: Bearer {{loginUser.response.body.$.jwt}}

{
  "items": [
    { "productoId": 999999, "cantidad": 1 }
  ]
}

###
# Esperado: 400 Bad Request — productoId duplicado en el mismo carrito
POST {{baseUrl}}/api/pedidos
Content-Type: application/json
Accept: application/json
Authorization: Bearer {{loginUser.response.body.$.jwt}}

{
  "items": [
    { "productoId": 1, "cantidad": 2 },
    { "productoId": 1, "cantidad": 3 }
  ]
}

###
# Esperado: 400 Bad Request — usuarioid no permitido en body
POST {{baseUrl}}/api/pedidos
Content-Type: application/json
Accept: application/json
Authorization: Bearer {{loginUser.response.body.$.jwt}}

{
  "items": [
    { "productoId": 1, "cantidad": 1 }
  ],
  "usuarioid": "otro-usuario-uuid"
}

###
# Esperado: 400 Bad Request — estado no permitido en body al crear
POST {{baseUrl}}/api/pedidos
Content-Type: application/json
Accept: application/json
Authorization: Bearer {{loginUser.response.body.$.jwt}}

{
  "items": [
    { "productoId": 1, "cantidad": 1 }
  ],
  "estado": "ENTREGADO"
}

###
# Esperado: 403 Forbidden — administrador no puede crear pedidos
POST {{baseUrl}}/api/pedidos
Content-Type: application/json
Accept: application/json
Authorization: Bearer {{loginAdmin.response.body.$.jwt}}

{
  "items": [
    { "productoId": 1, "cantidad": 1 }
  ]
}

###
# Esperado: 401 Unauthorized — sin token
POST {{baseUrl}}/api/pedidos
Content-Type: application/json
Accept: application/json

{
  "items": [
    { "productoId": 1, "cantidad": 1 }
  ]
}

### ── MIS PEDIDOS ──────────────────────────────────────────────

###
# Esperado: 200 OK — lista paginada de pedidos del usuario autenticado
GET {{baseUrl}}/api/pedidos/mios
Accept: application/json
Authorization: Bearer {{loginUser.response.body.$.jwt}}

###
# Esperado: 200 OK — paginación
GET {{baseUrl}}/api/pedidos/mios?page=1&limit=5
Accept: application/json
Authorization: Bearer {{loginUser.response.body.$.jwt}}

###
# Esperado: 403 Forbidden — administrador no tiene acceso a /mios
GET {{baseUrl}}/api/pedidos/mios
Accept: application/json
Authorization: Bearer {{loginAdmin.response.body.$.jwt}}

### ── DETALLE DE PEDIDO ────────────────────────────────────────

###
# Esperado: 200 OK — usuario ve su propio pedido (ajusta el id)
GET {{baseUrl}}/api/pedidos/{{crearPedido.response.body.$.id}}
Accept: application/json
Authorization: Bearer {{loginUser.response.body.$.jwt}}

###
# Esperado: 200 OK — administrador puede ver cualquier pedido
GET {{baseUrl}}/api/pedidos/{{crearPedido.response.body.$.id}}
Accept: application/json
Authorization: Bearer {{loginAdmin.response.body.$.jwt}}

###
# PRUEBA IDOR: usuario2 intenta ver el pedido del usuario1
# Esperado: 404 Not Found — el pedido existe pero no pertenece a este usuario
GET {{baseUrl}}/api/pedidos/{{crearPedido.response.body.$.id}}
Accept: application/json
Authorization: Bearer {{loginUser2.response.body.$.jwt}}

###
# Esperado: 404 Not Found — pedido inexistente
GET {{baseUrl}}/api/pedidos/999999
Accept: application/json
Authorization: Bearer {{loginUser.response.body.$.jwt}}

###
# Esperado: 400 Bad Request — id inválido
GET {{baseUrl}}/api/pedidos/abc
Accept: application/json
Authorization: Bearer {{loginAdmin.response.body.$.jwt}}

### ── LISTAR TODOS (ADMIN) ─────────────────────────────────────

###
# Esperado: 200 OK — lista paginada de todos los pedidos
GET {{baseUrl}}/api/pedidos
Accept: application/json
Authorization: Bearer {{loginAdmin.response.body.$.jwt}}

###
# Esperado: 200 OK — filtrar por estado PENDIENTE
GET {{baseUrl}}/api/pedidos?estado=PENDIENTE
Accept: application/json
Authorization: Bearer {{loginAdmin.response.body.$.jwt}}

###
# Esperado: 200 OK — filtrar por estado ENTREGADO
GET {{baseUrl}}/api/pedidos?estado=ENTREGADO
Accept: application/json
Authorization: Bearer {{loginAdmin.response.body.$.jwt}}

###
# Esperado: 400 Bad Request — estado de filtro inválido
GET {{baseUrl}}/api/pedidos?estado=INEXISTENTE
Accept: application/json
Authorization: Bearer {{loginAdmin.response.body.$.jwt}}

###
# Esperado: 403 Forbidden — usuario normal no puede listar todos
GET {{baseUrl}}/api/pedidos
Accept: application/json
Authorization: Bearer {{loginUser.response.body.$.jwt}}

### ── CAMBIAR ESTADO (ADMIN) ──────────────────────────────────

###
# Esperado: 200 OK — cambiar estado a EN_PROCESO
PATCH {{baseUrl}}/api/pedidos/{{crearPedido.response.body.$.id}}/estado
Content-Type: application/json
Accept: application/json
Authorization: Bearer {{loginAdmin.response.body.$.jwt}}

{
  "estado": "EN_PROCESO"
}

###
# Esperado: 200 OK — cambiar estado a ENVIADO
PATCH {{baseUrl}}/api/pedidos/{{crearPedido.response.body.$.id}}/estado
Content-Type: application/json
Accept: application/json
Authorization: Bearer {{loginAdmin.response.body.$.jwt}}

{
  "estado": "ENVIADO"
}

###
# Esperado: 200 OK — cambiar estado a ENTREGADO
PATCH {{baseUrl}}/api/pedidos/{{crearPedido.response.body.$.id}}/estado
Content-Type: application/json
Accept: application/json
Authorization: Bearer {{loginAdmin.response.body.$.jwt}}

{
  "estado": "ENTREGADO"
}

###
# Esperado: 200 OK — cancelar pedido
PATCH {{baseUrl}}/api/pedidos/{{crearPedido.response.body.$.id}}/estado
Content-Type: application/json
Accept: application/json
Authorization: Bearer {{loginAdmin.response.body.$.jwt}}

{
  "estado": "CANCELADO"
}

###
# Esperado: 400 Bad Request — estado no válido
PATCH {{baseUrl}}/api/pedidos/{{crearPedido.response.body.$.id}}/estado
Content-Type: application/json
Accept: application/json
Authorization: Bearer {{loginAdmin.response.body.$.jwt}}

{
  "estado": "INVENTADO"
}

###
# Esperado: 400 Bad Request — estado vacío
PATCH {{baseUrl}}/api/pedidos/{{crearPedido.response.body.$.id}}/estado
Content-Type: application/json
Accept: application/json
Authorization: Bearer {{loginAdmin.response.body.$.jwt}}

{
  "estado": ""
}

###
# Esperado: 403 Forbidden — usuario normal no puede cambiar estado
PATCH {{baseUrl}}/api/pedidos/{{crearPedido.response.body.$.id}}/estado
Content-Type: application/json
Accept: application/json
Authorization: Bearer {{loginUser.response.body.$.jwt}}

{
  "estado": "CANCELADO"
}

###
# Esperado: 404 Not Found — pedido inexistente al cambiar estado
PATCH {{baseUrl}}/api/pedidos/999999/estado
Content-Type: application/json
Accept: application/json
Authorization: Bearer {{loginAdmin.response.body.$.jwt}}

{
  "estado": "ENVIADO"
}

###
# Esperado: 401 Unauthorized — sin token al cambiar estado
PATCH {{baseUrl}}/api/pedidos/1/estado
Content-Type: application/json
Accept: application/json

{
  "estado": "ENVIADO"
}

### ── MÉTODOS NO PERMITIDOS ───────────────────────────────────

###
# Esperado: 405 Method Not Allowed
DELETE {{baseUrl}}/api/pedidos
Accept: application/json
Authorization: Bearer {{loginAdmin.response.body.$.jwt}}

###
# Esperado: 405 Method Not Allowed
PUT {{baseUrl}}/api/pedidos/1
Accept: application/json
Authorization: Bearer {{loginAdmin.response.body.$.jwt}}
